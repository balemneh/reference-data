x){.cbp-analytics-header__actions[_ngcontent-%COMP%]{width:100%;align-items:stretch}}.cbp-analytics-icon[_ngcontent-%COMP%]{width:2.5rem;height:2.5rem;color:var(--cbp-primary);filter:drop-shadow(0 2px 4px rgba(0,51,102,.1))}.cbp-real-time-indicator[_ngcontent-%COMP%]{display:flex;align-items:center;gap:var(--cbp-space-sm);padding:var(--cbp-space-sm) var(--cbp-space-md);background:#ef44441a;border:1px solid rgba(239,68,68,.2);border-radius:var(--cbp-radius-full);font-size:.875rem;font-weight:500;color:var(--cbp-error);transition:all var(--cbp-transition-fast)}.cbp-real-time-indicator.active[_ngcontent-%COMP%]{background:#10b9811a;border-color:#10b98133;color:var(--cbp-success)}.cbp-real-time-indicator.active[_ngcontent-%COMP%]   .cbp-pulse-dot[_ngcontent-%COMP%]{background:var(--cbp-success);animation:_ngcontent-%COMP%_cbpPulse 2s infinite}.cbp-pulse-dot[_ngcontent-%COMP%]{width:8px;height:8px;border-radius:50%;background:var(--cbp-error);flex-shrink:0}@keyframes _ngcontent-%COMP%_cbpPulse{0%,to{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.2)}}.cbp-time-range-selector[_ngcontent-%COMP%]   .cbp-time-select[_ngcontent-%COMP%]{min-width:180px;border-radius:var(--cbp-radius-lg);border:2px solid var(--cbp-neutral-300);background:#fff;font-weight:500;transition:all var(--cbp-transition-normal)}.cbp-time-range-selector[_ngcontent-%COMP%]   .cbp-time-select[_ngcontent-%COMP%]:focus{border-color:var(--cbp-primary);box-shadow:0 0 0 3px #0033661a}.cbp-analytics-actions[_ngcontent-%COMP%]{display:flex;gap:var(--cbp-space-md);align-items:center;flex-wrap:wrap}@media (max-width: 768px){.cbp-analytics-actions[_ngcontent-%COMP%]{justify-content:center;width:100%}}.cbp-export-dropdown[_ngcontent-%COMP%]{display:flex;align-items:center;gap:var(--cbp-space-sm);background:#fff;border:1px solid var(--cbp-neutral-300);border-radius:var(--cbp-radius-lg);overflow:hidden}.cbp-export-dropdown[_ngcontent-%COMP%]   .cbp-export-select[_ngcontent-%COMP%]{border:none;background:tr